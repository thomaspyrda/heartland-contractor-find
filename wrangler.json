{
  "name": "heartland-contractor-find",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-11-20",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "heartland-inquiries",
      "database_id": "4558cf79-d93b-4309-8097-b63605237bf5",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PHOTOS",
      "bucket_name": "heartland-inquiry-photos"
    }
  ],
  "triggers": {
    "crons": [
      "*/15 * * * *"
    ]
  },
  "keep_vars": true
}
